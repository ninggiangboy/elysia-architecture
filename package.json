{
  "name": "elysia-architecture",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "deploy": "bun run --cwd apps/api deploy",
    "stripe:listen": "bun scripts/stripe.ts listen",
    "stripe:secret": "bun scripts/stripe.ts secret",
    "test:stripe": "bun run --filter @app/api test:stripe",
    "build": "bun run --filter './apps/*' build",
    "typecheck": "bun run --filter './apps/*' --filter './packages/*' typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun run --filter './apps/*' --filter './packages/*' test",
    "test:coverage": "bun run --filter @app/api test:coverage",
    "quality:unused": "knip",
    "quality:dup": "jscpd",
    "infra:up": "docker compose up -d --wait postgres mailpit seaweedfs jaeger && docker compose --profile init run --rm seaweedfs-init",
    "infra:down": "docker compose --profile app down",
    "setup": "cp -n .env.example .env; bun install && bun run --filter @app/api keys:generate && bun run infra:up && bun run --filter @app/api db:migrate",
    "test:e2e": "bun run --filter @app/api test:e2e && bun run --filter @app/web test:e2e",
    "check:arch": "bun run --filter @app/api check:arch"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "jscpd": "^5.4.1",
    "knip": "^6.41.0",
    "typescript": "^5.9.0"
  }
}
