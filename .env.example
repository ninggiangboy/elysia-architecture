# ---- API ----
PORT=3000
APP_ROLES=api,relay
LOG_LEVEL=info
WEB_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ---- Postgres (mỗi module có thể trỏ DB riêng; mặc định dùng DATABASE_URL) ----
DATABASE_URL=postgres://app:app@localhost:5433/app
# IDENTITY_DATABASE_URL=
# PROFILE_DATABASE_URL=
# NOTIFICATION_DATABASE_URL=
DB_POOL_MAX=10
DB_PREPARE=true

# ---- JWT ES256 (chạy `bun run --filter api keys:generate` để sinh) ----
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KID=dev-1
JWT_ISSUER=elysia-architecture
JWT_AUDIENCE=elysia-architecture-web
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# ---- S3 (SeaweedFS) ----
S3_ENDPOINT=http://localhost:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=avatars
S3_ACCESS_KEY_ID=app-access-key
S3_SECRET_ACCESS_KEY=app-secret-key

# ---- SMTP (Mailpit) ----
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP có xác thực / TLS (vd. Amazon SES SMTP: email-smtp.<region>.amazonaws.com, cổng 587, REQUIRE_TLS=true)
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false        # true cho cổng 465
# SMTP_REQUIRE_TLS=false   # true cho cổng 587 (STARTTLS)
MAIL_FROM="Elysia App <no-reply@example.test>"

# ---- Giới hạn gửi mail (dùng chung giữa các instance, lưu trong Postgres) ----
# Đặt bằng "max send rate" của nhà cung cấp (SES sandbox: 1, production: thường 14+)
MAIL_RATE_PER_SECOND=10
# MAIL_BURST=              # mặc định = ceil(MAIL_RATE_PER_SECOND)
MAIL_DAILY_QUOTA=0         # 0 = không giới hạn; SES: "24-hour sending quota"
# Thời gian tối đa một mail được hoãn vì rate limit trước khi vào dead-letter
OUTBOX_DEFER_BUDGET_HOURS=24
