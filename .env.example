# Generated from the config slices: run `bun run --filter @app/api config:example` after changing one. Do not edit by hand.

# ---- API process ----
# Runtime mode. The OpenAPI docs are served only in development.
# NODE_ENV=production
# Port the API listens on.
# PORT=3000
# `api` serves HTTP; `worker` runs the outbox relay and with it every event handler, including the heavy ones (avatar thumbnails). Split them: `api` on web boxes, `worker` on their own.
# APP_ROLES=api,worker
# Cluster mode: processes sharing PORT (a number, or `auto` = 3/4 of the CPUs, min 2 so a crash never takes the whole instance down). 1 = single process, no supervisor. DB_POOL_MAX is per process.
# APP_PROCESSES=1
# Set by the cluster supervisor (0-based); the outbox relay only runs in slot 0. Do not set by hand.
# PROCESS_SLOT=
# Log verbosity.
# LOG_LEVEL=info
# Where the web app is served: links in mails, OAuth redirects, WebAuthn defaults.
# WEB_APP_URL=http://localhost:5173
# Origins allowed to call the API from a browser, comma separated.
CORS_ORIGINS=http://localhost:5173

# ---- Postgres (one shared pool; modules are separated by schema) ----
# Connection string.
DATABASE_URL=postgres://app:app@localhost:5433/app
# Pool size. Per process: Postgres sees APP_PROCESSES × DB_POOL_MAX connections per instance.
DB_POOL_MAX=10
# Use prepared statements. Turn off behind a transaction-mode pooler (PgBouncer).
# DB_PREPARE=true

# ---- Object storage (S3-compatible: SeaweedFS in dev) ----
# Endpoint the API talks to.
S3_ENDPOINT=http://localhost:8333
# Endpoint browsers use for presigned links, when it differs from S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=http://localhost:8333
# Region.
# S3_REGION=us-east-1
# Bucket for avatars, covers and data exports.
S3_BUCKET=avatars
# Access key id.
S3_ACCESS_KEY_ID=app-access-key
# Secret access key.
S3_SECRET_ACCESS_KEY=app-secret-key

# ---- Mail (SMTP: Mailpit in dev) and send throttling ----
# Amazon SES SMTP: host email-smtp.<region>.amazonaws.com, port 587, SMTP_REQUIRE_TLS=true. The rate limits are shared across instances (stored in Postgres).
# SMTP server.
SMTP_HOST=localhost
# SMTP port.
SMTP_PORT=1025
# SMTP user, when the server needs auth.
# SMTP_USER=
# SMTP password.
# SMTP_PASSWORD=
# TLS from the first byte: true for port 465.
# SMTP_SECURE=false
# Require STARTTLS: true for port 587.
# SMTP_REQUIRE_TLS=false
# From address of every mail.
MAIL_FROM="Elysia App <no-reply@example.test>"
# Maximum send rate (mails/second); the provider's "max send rate" (SES sandbox: 1).
MAIL_RATE_PER_SECOND=10
# Mails that may go out in one burst; defaults to ceil(MAIL_RATE_PER_SECOND).
# MAIL_BURST=
# Quota per day (UTC); 0 = unlimited. SES: the "24-hour sending quota".
# MAIL_DAILY_QUOTA=0

# ---- Outbox relay (events between modules) ----
# How often the relay looks for new messages.
# OUTBOX_POLL_INTERVAL_MS=1000
# Messages claimed per relay batch.
# OUTBOX_BATCH_SIZE=200
# Aggregates processed in parallel per batch; keep below DB_POOL_MAX. Messages of one aggregate stay ordered.
# OUTBOX_CONCURRENCY=8
# How long a claimed message stays reserved for this relay. Past it another relay may take it, so keep it above the slowest handler (image processing).
# OUTBOX_LEASE_SECONDS=30
# Maximum time a message may be deferred by a rate limit (mail) before it is considered dead.
# OUTBOX_DEFER_BUDGET_HOURS=24

# ---- Maintenance mode (`bun run deploy` sets it) ----
# How often each process reads the maintenance flag; it takes this long to take effect.
# MAINTENANCE_POLL_INTERVAL_MS=1000

# ---- Tracing (OpenTelemetry → Jaeger UI at http://localhost:16686; `bun run infra:up` starts it) ----
# Spans are exported when the endpoint is set: HTTP request → outbox relay → event handlers, linked through the message headers.
# OTLP/HTTP endpoint of a collector (Jaeger: http://localhost:4318). Unset = tracing off.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Service name on the spans.
# OTEL_SERVICE_NAME=elysia-architecture-api

# ---- Identity: tokens, passkeys, OAuth, magic links ----
# Generate the JWT keys and STEP_UP_CODE_SECRET with `bun run --filter @app/api keys:generate`.
# ES256 private key (PKCS8 PEM, newlines as \n).
JWT_PRIVATE_KEY=
# ES256 public key (SPKI PEM, newlines as \n).
JWT_PUBLIC_KEY=
# Key id published in the JWKS.
JWT_KID=dev-1
# `iss` of the access tokens.
JWT_ISSUER=elysia-architecture
# `aud` of the access tokens.
JWT_AUDIENCE=elysia-architecture-web
# Lifetime of an access token.
# ACCESS_TOKEN_TTL=15m
# Lifetime of a refresh token (a session).
# REFRESH_TOKEN_TTL=30d
# How long after signing in (or confirming again) sensitive actions — change email, add/remove a sign-in method — are allowed; after that the API answers 403 step_up_required.
# STEP_UP_TTL=5m
# Key for hashing the emailed step-up codes (HMAC, 32+ chars). Changing it invalidates the codes in flight (they live 10 minutes).
STEP_UP_CODE_SECRET=
# WebAuthn relying party id; defaults to the host of WEB_APP_URL. Changing it makes every registered passkey unusable.
# WEBAUTHN_RP_ID=
# Relying party name shown by the browser.
# WEBAUTHN_RP_NAME=Elysia Architecture
# Origins the browser may report during a passkey ceremony; defaults to the origin of WEB_APP_URL.
# WEBAUTHN_ORIGINS=
# Sign in with Google: a provider is on only when both its id and secret are set. Register `<WEB_APP_URL>/auth/oauth/callback` as the redirect URI.
# GOOGLE_CLIENT_ID=
# Google client secret.
# GOOGLE_CLIENT_SECRET=
# Sign in with GitHub (same rule as Google).
# GITHUB_CLIENT_ID=
# GitHub client secret.
# GITHUB_CLIENT_SECRET=
# Magic links one address can ask for within the throttle window.
# MAGIC_LINK_MAX_PER_EMAIL=3
# Magic links one IP can ask for within the throttle window.
# MAGIC_LINK_MAX_PER_IP=10

# ---- Notifications: Web Push and retention ----
# Web Push (VAPID) is off unless all three VAPID values are set; `keys:generate` writes them. Changing the key pair drops every existing browser subscription.
# Web Push public key (URL-safe base64).
# VAPID_PUBLIC_KEY=
# Web Push private key.
# VAPID_PRIVATE_KEY=
# A `mailto:` or `https://` contact for the push services.
# VAPID_SUBJECT=
# After a Web Push to a user, notifications in the same window of this length are stored but not pushed; 0 = push all.
# PUSH_QUIET_WINDOW_SECONDS=30
# In-app notifications older than this are deleted (read or not).
# NOTIFICATION_RETENTION=90d
# How often notifications past the retention are looked for.
# NOTIFICATION_PRUNE_INTERVAL_SECONDS=3600

# ---- Privacy: data export and account deletion ----
# Account deletion: time between asking and the erasure starting. The user can cancel in between.
# PRIVACY_DELETION_GRACE_PERIOD=14d
# How long a finished data export can be downloaded. At most 7d: the longest an S3 presigned link can live.
# PRIVACY_EXPORT_TTL=7d
# How often the jobs look for deletions whose grace period ended, silent modules and expired exports.
# PRIVACY_JOBS_INTERVAL_SECONDS=30
# A data export or an erasure with no progress for this long is re-sent to the modules that have not answered.
# PRIVACY_STALL_AFTER=10m
# Re-sends before giving up: an export then fails, an erasure waits for an operator (`privacy:resume`).
# PRIVACY_MAX_NUDGES=5

# ---- Billing: top-ups with Stripe ----
# Leave the three Stripe values unset to turn top-ups off (balances and history still work).
# 1. Take the test keys from https://dashboard.stripe.com/test/apikeys
# 2. `bun run stripe:secret` prints the webhook signing secret the Stripe CLI uses locally
# 3. `bun run dev` then forwards Stripe webhooks to the API (needs the `stripe` CLI or docker)
# In production create a webhook endpoint for `<API>/api/billing/webhooks/stripe` with the events payment_intent.succeeded, payment_intent.payment_failed, payment_intent.canceled, refund.created, refund.updated, charge.dispute.created, charge.dispute.updated and charge.dispute.closed, and use its secret.
# Stripe secret key (`sk_test_…`).
# STRIPE_SECRET_KEY=
# Stripe publishable key (`pk_test_…`).
# STRIPE_PUBLISHABLE_KEY=
# Signing secret of the webhook endpoint (`whsec_…`).
# STRIPE_WEBHOOK_SECRET=
# How often payments whose webhook has not come are checked against Stripe.
# BILLING_RECONCILE_INTERVAL_SECONDS=300
# An open payment is left to its webhook this long; after that Stripe is asked, and again every this long.
# BILLING_SETTLE_GRACE=15m
# Payments older than this that never completed are no longer checked.
# BILLING_RECONCILE_MAX_AGE=3d
# Who issues the invoices, receipts and credit notes; written onto each document when it is issued.
# SELLER_NAME=Elysia Architecture
# Seller address.
# SELLER_ADDRESS=
# VAT number, MST or the like.
# SELLER_TAX_ID=
# Seller contact email.
# SELLER_EMAIL=
# Currencies a wallet can be topped up in, comma separated (the ranges are in `packages/shared-types/src/billing.ts`).
# TOPUP_CURRENCIES=usd,eur,vnd

# ---- Realtime (SSE) ----
# How long a disconnected SSE client can still replay the events that opted in (`session.revoked`) via `Last-Event-ID`. Keep it at least ACCESS_TOKEN_TTL: after that a device that missed its sign-out can no longer refresh its session anyway.
# REALTIME_REPLAY_WINDOW_SECONDS=900
