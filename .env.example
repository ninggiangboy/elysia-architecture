# ---- API ----
PORT=3000
# api = HTTP, worker = outbox relay + event handlers (mail, push, avatar thumbnails). Split them: APP_ROLES=api on web boxes, APP_ROLES=worker on their own
APP_ROLES=api,worker
# Cluster mode: processes sharing PORT (number or `auto` = 3/4 of the CPUs, min 2). 1 = single process.
# DB_POOL_MAX is per process, so Postgres sees APP_PROCESSES × DB_POOL_MAX connections per instance.
# APP_PROCESSES=1
LOG_LEVEL=info
WEB_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ---- Maintenance mode (`bun run deploy` sets it): how often each process reads the flag, i.e. how long it takes to take effect ----
# MAINTENANCE_POLL_INTERVAL_MS=1000

# ---- Tracing (OpenTelemetry → Jaeger UI at http://localhost:16686; `bun run infra:up` starts it) ----
# Spans are exported by default (comment the endpoint out to turn tracing off): HTTP request → outbox relay → event handlers, linked through the message headers.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=elysia-architecture-api

# ---- Postgres (one shared pool; modules are separated by schema) ----
DATABASE_URL=postgres://app:app@localhost:5433/app
DB_POOL_MAX=10
DB_PREPARE=true

# ---- JWT ES256 (run `bun run --filter api keys:generate` to generate) ----
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KID=dev-1
JWT_ISSUER=elysia-architecture
JWT_AUDIENCE=elysia-architecture-web
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# ---- Sensitive actions (change email, add/remove a passkey or connected account) ----
# How long after signing in / confirming again they stay allowed; after that the API answers 403 step_up_required.
# STEP_UP_TTL=5m

# ---- Passkeys (WebAuthn) — default to WEB_APP_URL. Changing the RP id makes every registered passkey unusable. ----
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME="Elysia Architecture"
# WEBAUTHN_ORIGINS=http://localhost:5173

# ---- Sign in with Google / GitHub — a provider is on only when both values are set ----
# Redirect URI to register with each provider: ${WEB_APP_URL}/auth/oauth/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ---- Top-ups with Stripe — leave the three unset to turn top-ups off (balances and history still work) ----
# 1. Take the test keys from https://dashboard.stripe.com/test/apikeys
# 2. `bun run stripe:secret` prints the webhook signing secret the Stripe CLI uses locally
# 3. `bun run dev` then forwards Stripe's webhooks to the API (needs the `stripe` CLI or docker)
# In production create a webhook endpoint for `${API}/api/billing/webhooks/stripe` with the events
# payment_intent.succeeded, payment_intent.payment_failed, payment_intent.canceled, refund.created, refund.updated,
# charge.dispute.created, charge.dispute.updated and charge.dispute.closed, and use its secret.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Webhooks can be lost, so open payments are also asked about at Stripe: how often the job runs, how long a payment is left
# to its webhook (and between two asks), and how old a payment may be before it is given up on.
# BILLING_RECONCILE_INTERVAL_SECONDS=300
# BILLING_SETTLE_GRACE=15m
# BILLING_RECONCILE_MAX_AGE=3d
# Who the invoices, receipts and credit notes come from (written onto each document when it is issued)
# SELLER_NAME=Elysia Architecture
# SELLER_ADDRESS=1 Example Street, Ho Chi Minh City
# SELLER_TAX_ID=
# SELLER_EMAIL=billing@example.com
# Currencies a wallet can be topped up in (ranges: packages/shared-types/src/billing.ts)
# TOPUP_CURRENCIES=usd,eur,vnd

# ---- Web Push (VAPID) — `keys:generate` writes these; leave all three unset to disable Web Push ----
# Changing the key pair drops every existing browser subscription. Subject: a mailto: or https:// contact for push services.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# ---- S3 (SeaweedFS) ----
S3_ENDPOINT=http://localhost:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=avatars
S3_ACCESS_KEY_ID=app-access-key
S3_SECRET_ACCESS_KEY=app-secret-key

# ---- SMTP (Mailpit) ----
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP with auth / TLS (e.g. Amazon SES SMTP: email-smtp.<region>.amazonaws.com, port 587, REQUIRE_TLS=true)
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false        # true for port 465
# SMTP_REQUIRE_TLS=false   # true for port 587 (STARTTLS)
MAIL_FROM="Elysia App <no-reply@example.test>"

# ---- Mail send throttling (shared across instances, stored in Postgres) ----
# Set to the provider's "max send rate" (SES sandbox: 1, production: usually 14+)
MAIL_RATE_PER_SECOND=10
# MAIL_BURST=              # defaults to ceil(MAIL_RATE_PER_SECOND)
MAIL_DAILY_QUOTA=0         # 0 = unlimited; SES: "24-hour sending quota"
# Maximum time a mail may be deferred by the rate limit before going to the dead-letter queue
OUTBOX_DEFER_BUDGET_HOURS=24
# Web Push: notifications within this window of a user's previous one are stored but not pushed (0 = push all)
# PUSH_QUIET_WINDOW_SECONDS=30
# SSE: how long a reconnecting client can replay events that opt in to replay (session.revoked); keep >= ACCESS_TOKEN_TTL
# REALTIME_REPLAY_WINDOW_SECONDS=900
# ---- Privacy: data export and account deletion ----
# Time between asking to delete the account and the erasure starting; the user can cancel in between.
# PRIVACY_DELETION_GRACE_PERIOD=14d
# How long a finished data export can be downloaded (at most 7d: the longest an S3 presigned link lives).
# PRIVACY_EXPORT_TTL=7d
# How often the jobs look for deletions whose grace period ended, silent modules and expired exports.
# PRIVACY_JOBS_INTERVAL_SECONDS=30
# A job with no progress for this long is re-sent to the modules that have not answered; after PRIVACY_MAX_NUDGES re-sends an
# export fails and an erasure waits for an operator (`bun run --filter @app/api privacy:resume -- --id <uuid>`).
# PRIVACY_STALL_AFTER=10m
# PRIVACY_MAX_NUDGES=5
# OUTBOX_BATCH_SIZE=200
# OUTBOX_CONCURRENCY=8       # keep below DB_POOL_MAX
# OUTBOX_LEASE_SECONDS=30    # raise on the worker: avatar thumbnails (sharp) must finish within it
