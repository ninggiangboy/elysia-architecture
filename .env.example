# ---- API ----
PORT=3000
APP_ROLES=api,relay
LOG_LEVEL=info
WEB_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ---- Postgres (one shared pool; modules are separated by schema) ----
DATABASE_URL=postgres://app:app@localhost:5433/app
DB_POOL_MAX=10
DB_PREPARE=true

# ---- JWT ES256 (run `bun run --filter api keys:generate` to generate) ----
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KID=dev-1
JWT_ISSUER=elysia-architecture
JWT_AUDIENCE=elysia-architecture-web
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# ---- Web Push (VAPID) — `keys:generate` writes these; leave all three unset to disable Web Push ----
# Changing the key pair drops every existing browser subscription. Subject: a mailto: or https:// contact for push services.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# ---- S3 (SeaweedFS) ----
S3_ENDPOINT=http://localhost:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=avatars
S3_ACCESS_KEY_ID=app-access-key
S3_SECRET_ACCESS_KEY=app-secret-key

# ---- SMTP (Mailpit) ----
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP with auth / TLS (e.g. Amazon SES SMTP: email-smtp.<region>.amazonaws.com, port 587, REQUIRE_TLS=true)
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false        # true for port 465
# SMTP_REQUIRE_TLS=false   # true for port 587 (STARTTLS)
MAIL_FROM="Elysia App <no-reply@example.test>"

# ---- Mail send throttling (shared across instances, stored in Postgres) ----
# Set to the provider's "max send rate" (SES sandbox: 1, production: usually 14+)
MAIL_RATE_PER_SECOND=10
# MAIL_BURST=              # defaults to ceil(MAIL_RATE_PER_SECOND)
MAIL_DAILY_QUOTA=0         # 0 = unlimited; SES: "24-hour sending quota"
# Maximum time a mail may be deferred by the rate limit before going to the dead-letter queue
OUTBOX_DEFER_BUDGET_HOURS=24
# OUTBOX_BATCH_SIZE=200
# OUTBOX_CONCURRENCY=8       # keep below DB_POOL_MAX
