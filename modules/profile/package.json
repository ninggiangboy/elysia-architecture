{
  "name": "@mod/profile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "bun": "./src/contracts/index.ts",
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./manifest": {
      "bun": "./src/manifest.ts",
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./schema": {
      "bun": "./src/infrastructure/persistence/schema.ts",
      "types": "./dist/infrastructure/persistence/schema.d.ts",
      "default": "./dist/infrastructure/persistence/schema.js"
    },
    "./public": {
      "bun": "./src/public.ts",
      "types": "./dist/public.d.ts",
      "default": "./dist/public.js"
    }
  },
  "files": [
    "dist",
    "src",
    "migrations",
    "kit.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun --env-file=../../.env test src",
    "build": "bun ../../scripts/build-package.ts"
  },
  "dependencies": {
    "@kit/auth": "workspace:*",
    "@kit/core": "workspace:*",
    "@kit/db": "workspace:*",
    "@kit/http": "workspace:*",
    "@kit/messaging": "workspace:*",
    "@kit/privacy-participant": "workspace:*",
    "@kit/runtime": "workspace:*",
    "@kit/storage": "workspace:*",
    "@mod/identity": "workspace:*",
    "sharp": "^0.35.5"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.0"
  },
  "devDependencies": {
    "@kit/testing": "workspace:*",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.0",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.0"
  }
}
