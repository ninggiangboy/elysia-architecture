{
  "name": "@mod/notification",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "bun": "./src/contracts/index.ts",
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./config": {
      "bun": "./src/config.ts",
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./manifest": {
      "bun": "./src/manifest.ts",
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./schema": {
      "bun": "./src/infrastructure/persistence/schema.ts",
      "types": "./dist/infrastructure/persistence/schema.d.ts",
      "default": "./dist/infrastructure/persistence/schema.js"
    },
    "./integrations/realtime": {
      "bun": "./src/integrations/realtime.ts",
      "types": "./dist/integrations/realtime.d.ts",
      "default": "./dist/integrations/realtime.js"
    },
    "./testing": {
      "bun": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "src",
    "migrations",
    "kit.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun --env-file=../../.env test src",
    "build": "bun ../../scripts/build-package.ts"
  },
  "dependencies": {
    "@app/shared-types": "workspace:*",
    "@kit/auth": "workspace:*",
    "@kit/config": "workspace:*",
    "@kit/core": "workspace:*",
    "@kit/db": "workspace:*",
    "@kit/http": "workspace:*",
    "@kit/i18n": "workspace:*",
    "@kit/mail": "workspace:*",
    "@kit/messaging": "workspace:*",
    "@kit/privacy-participant": "workspace:*",
    "@kit/runtime": "workspace:*",
    "@kit/storage": "workspace:*",
    "web-push": "^3.6.7"
  },
  "peerDependencies": {
    "@mod/realtime": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.0",
    "zod": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "@mod/realtime": {
      "optional": true
    }
  },
  "devDependencies": {
    "@kit/testing": "workspace:*",
    "@mod/realtime": "workspace:*",
    "@types/bun": "latest",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.0",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.0",
    "zod": "^4.1.0"
  }
}
