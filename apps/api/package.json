{
  "name": "@app/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "NODE_ENV=development bun --env-file=../../.env --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "bun build src/main.ts --target=bun --outdir=dist",
    "keys:generate": "bun scripts/generate-keys.ts",
    "config:example": "bun scripts/config-example.ts",
    "db:generate": "bun --env-file=../../.env scripts/db.ts generate",
    "db:migrate": "bun --env-file=../../.env scripts/db.ts migrate",
    "db:studio": "MODULE=${MODULE:-identity} bunx --bun drizzle-kit studio",
    "test": "bun --env-file=../../.env test src",
    "test:coverage": "bun --env-file=../../.env test src --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "test:stripe": "bun --env-file=../../.env scripts/stripe-smoke.ts",
    "test:e2e": "bun --env-file=../../.env test tests/e2e --timeout 30000",
    "typecheck": "tsc --noEmit",
    "check:arch": "depcruise src --config .dependency-cruiser.cjs",
    "deploy": "bun --env-file=../../.env scripts/deploy.ts",
    "outbox:list": "bun --env-file=../../.env scripts/outbox.ts list",
    "outbox:requeue": "bun --env-file=../../.env scripts/outbox.ts requeue",
    "privacy:list": "bun --env-file=../../.env scripts/privacy.ts list",
    "privacy:resume": "bun --env-file=../../.env scripts/privacy.ts resume"
  },
  "dependencies": {
    "@app/shared-types": "workspace:*",
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/openapi": "^1.4.0",
    "@kit/config": "workspace:*",
    "@kit/context": "workspace:*",
    "@kit/core": "workspace:*",
    "@kit/db": "workspace:*",
    "@kit/i18n": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@simplewebauthn/server": "^14.0.3",
    "arctic": "^3.7.0",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.0",
    "fflate": "^0.8.3",
    "jose": "^6.1.0",
    "nodemailer": "^10.1.1",
    "pino": "^10.4.0",
    "postgres": "^3.4.7",
    "sharp": "^0.35.5",
    "stripe": "^23.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.0"
  }
}
