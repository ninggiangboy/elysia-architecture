# Generated from the config slices: run `bun run config:example` after changing one. Do not edit by hand.

# ---- API process ----
# Runtime mode. The OpenAPI docs are served only in development.
# NODE_ENV=production
# Port the API listens on.
# PORT=3000
# `api` serves HTTP; `worker` runs the outbox relay and with it every event handler, including the heavy ones (avatar thumbnails). Split them: `api` on web boxes, `worker` on their own.
# APP_ROLES=api,worker
# Cluster mode: processes sharing PORT (a number, or `auto` = 3/4 of the CPUs, min 2 so a crash never takes the whole instance down). 1 = single process, no supervisor. DB_POOL_MAX is per process.
# APP_PROCESSES=1
# Set by the cluster supervisor (0-based); the outbox relay only runs in slot 0. Do not set by hand.
# PROCESS_SLOT=
# Log verbosity.
# LOG_LEVEL=info
# Where the web app is served: links in mails, OAuth redirects, WebAuthn defaults.
# WEB_APP_URL=http://localhost:5173
# Origins allowed to call the API from a browser, comma separated.
CORS_ORIGINS=http://localhost:5173

# ---- Postgres (one shared pool; modules are separated by schema) ----
# Connection string.
DATABASE_URL=postgres://app:app@localhost:5433/app
# Pool size. Per process: Postgres sees APP_PROCESSES × DB_POOL_MAX connections per instance.
DB_POOL_MAX=10
# Use prepared statements. Turn off behind a transaction-mode pooler (PgBouncer).
# DB_PREPARE=true

# ---- Object storage (S3-compatible: SeaweedFS in dev) or the local disk ----
# STORAGE_DRIVER=local keeps files on disk and serves them from the API itself, so a project can start without an S3 service.
# Where files live: `s3` (any S3-compatible service) or `local` (the disk of the API server).
STORAGE_DRIVER=local
# s3: endpoint the API talks to.
# S3_ENDPOINT=
# s3: endpoint browsers use for presigned links, when it differs from S3_ENDPOINT.
# S3_PUBLIC_ENDPOINT=
# s3: region.
# S3_REGION=us-east-1
# s3: bucket for avatars, covers and data exports.
# S3_BUCKET=
# s3: access key id.
# S3_ACCESS_KEY_ID=
# s3: secret access key.
# S3_SECRET_ACCESS_KEY=
# local: folder the files are written to.
# STORAGE_LOCAL_DIR=./.data/storage
# local: key that signs upload and download links (32+ chars). Changing it invalidates links already handed out.
STORAGE_LOCAL_SECRET=
# local: where browsers reach the API (links look like `<this>/storage/local/<key>?…`).
# STORAGE_LOCAL_PUBLIC_URL=http://localhost:3000/api

# ---- Mail (SMTP: Mailpit in dev, or just the log) and send throttling ----
# Amazon SES SMTP: host email-smtp.<region>.amazonaws.com, port 587, SMTP_REQUIRE_TLS=true. The rate limits are shared across instances (stored in Postgres).
# `smtp` sends through SMTP_HOST; `console` sends nothing and prints each mail to the log (for trying the app without a mail server).
MAIL_DRIVER=console
# console: also print the links found in each mail (sign-in links!). Turn off anywhere the log is shared.
# MAIL_CONSOLE_PRINT_LINKS=true
# SMTP server.
# SMTP_HOST=localhost
# SMTP port.
# SMTP_PORT=1025
# SMTP user, when the server needs auth.
# SMTP_USER=
# SMTP password.
# SMTP_PASSWORD=
# TLS from the first byte: true for port 465.
# SMTP_SECURE=false
# Require STARTTLS: true for port 587.
# SMTP_REQUIRE_TLS=false
# From address of every mail.
# MAIL_FROM=App <no-reply@example.test>
# Maximum send rate (mails/second); the provider's "max send rate" (SES sandbox: 1).
MAIL_RATE_PER_SECOND=10
# Mails that may go out in one burst; defaults to ceil(MAIL_RATE_PER_SECOND).
# MAIL_BURST=
# Quota per day (UTC); 0 = unlimited. SES: the "24-hour sending quota".
# MAIL_DAILY_QUOTA=0

# ---- Outbox relay (events between modules) ----
# How often the relay looks for new messages.
# OUTBOX_POLL_INTERVAL_MS=1000
# Messages claimed per relay batch.
# OUTBOX_BATCH_SIZE=200
# Aggregates processed in parallel per batch; keep below DB_POOL_MAX. Messages of one aggregate stay ordered.
# OUTBOX_CONCURRENCY=8
# How long a claimed message stays reserved for this relay. Past it another relay may take it, so keep it above the slowest handler (image processing).
# OUTBOX_LEASE_SECONDS=30
# Maximum time a message may be deferred by a rate limit (mail) before it is considered dead.
# OUTBOX_DEFER_BUDGET_HOURS=24

# ---- Maintenance mode (`bun run deploy` sets it) ----
# How often each process reads the maintenance flag; it takes this long to take effect.
# MAINTENANCE_POLL_INTERVAL_MS=1000

# ---- Tracing (OpenTelemetry → Jaeger UI at http://localhost:16686; `bun run infra:up` starts it) ----
# Spans are exported when the endpoint is set: HTTP request → outbox relay → event handlers, linked through the message headers.
# OTLP/HTTP endpoint of a collector (Jaeger: http://localhost:4318). Unset = tracing off.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# Service name on the spans.
# OTEL_SERVICE_NAME=elysia-architecture-api

# ---- Identity: sign-in methods, registration, tokens, passkeys, OAuth, 2FA ----
# Generate the JWT keys, STEP_UP_CODE_SECRET and TOTP_ENCRYPTION_KEY with `bun run --filter @app/api keys:generate`.
# ES256 private key (PKCS8 PEM, newlines as \n).
JWT_PRIVATE_KEY=
# ES256 public key (SPKI PEM, newlines as \n).
JWT_PUBLIC_KEY=
# Key id published in the JWKS.
JWT_KID=dev-1
# `iss` of the access tokens.
JWT_ISSUER=elysia-architecture
# `aud` of the access tokens.
JWT_AUDIENCE=elysia-architecture-web
# Lifetime of an access token.
# ACCESS_TOKEN_TTL=15m
# Lifetime of a refresh token (a session).
# REFRESH_TOKEN_TTL=30d
# How long after signing in (or confirming again) sensitive actions — change email, add/remove a sign-in method — are allowed; after that the API answers 403 step_up_required.
# STEP_UP_TTL=5m
# Key for hashing the emailed step-up codes (HMAC, 32+ chars). Changing it invalidates the codes in flight (they live 10 minutes).
STEP_UP_CODE_SECRET=
# WebAuthn relying party id; defaults to the host of WEB_APP_URL. Changing it makes every registered passkey unusable.
# WEBAUTHN_RP_ID=
# Relying party name shown by the browser.
# WEBAUTHN_RP_NAME=Elysia Architecture
# Origins the browser may report during a passkey ceremony; defaults to the origin of WEB_APP_URL.
# WEBAUTHN_ORIGINS=
# Sign in with Google: a provider is on only when both its id and secret are set. Register `<WEB_APP_URL>/auth/oauth/callback` as the redirect URI.
# GOOGLE_CLIENT_ID=
# Google client secret.
# GOOGLE_CLIENT_SECRET=
# Sign in with GitHub (same rule as Google).
# GITHUB_CLIENT_ID=
# GitHub client secret.
# GITHUB_CLIENT_SECRET=
# Sign in with Microsoft (Entra ID, same rule as Google). Only personal accounts, and work accounts whose tenant sends the `xms_edov` claim, have an email Microsoft vouches for.
# MICROSOFT_CLIENT_ID=
# Microsoft client secret.
# MICROSOFT_CLIENT_SECRET=
# `common` (any account), `consumers`, `organizations` or one tenant id.
# MICROSOFT_TENANT=common
# Sign in with Discord (same rule as Google).
# DISCORD_CLIENT_ID=
# Discord client secret.
# DISCORD_CLIENT_SECRET=
# Any OpenID Connect provider (Keycloak, Auth0, Okta…), as a JSON array of `{"id","name","issuer","clientId","clientSecret","scopes"?}`. Endpoints come from the issuer's discovery document; the provider must send `email_verified`.
# OIDC_PROVIDERS=
# Ways to sign in, comma-separated: `email` (a link and a code by mail), `password`, `passkey`. OAuth providers are on when their credentials are set.
# SIGN_IN_METHODS=email,password,passkey
# `open`: anyone can create an account; `invite`: only addresses a member invited; `closed`: no new accounts.
# REGISTRATION_MODE=open
# Only addresses at these domains may create an account (comma-separated); unset = any domain.
# REGISTRATION_EMAIL_DOMAINS=
# Addresses that may always create an account, also when the mode is `invite` or `closed` (the owner who seeds the app).
# REGISTRATION_ALLOWED_EMAILS=
# When set, creating an account requires accepting these terms; the version is recorded on the account.
# TERMS_VERSION=
# Where the terms are published, linked from the sign-up page.
# TERMS_URL=
# Shortest password accepted (at most 128).
# PASSWORD_MIN_LENGTH=8
# Two-factor authentication with an authenticator app is on when set: the key (32+ chars) that encrypts the stored TOTP secrets. Changing it locks every enrolled account out of password and email sign-in until the old key is back; unset, two-factor is off.
# TOTP_ENCRYPTION_KEY=
# Name the authenticator app shows next to the code; defaults to WEBAUTHN_RP_NAME.
# TOTP_ISSUER=
# Magic links one address can ask for within the throttle window.
# MAGIC_LINK_MAX_PER_EMAIL=3
# Magic links one IP can ask for within the throttle window.
# MAGIC_LINK_MAX_PER_IP=10
