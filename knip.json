{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    "apps/api": {
      "entry": ["scripts/*.ts", "tests/e2e/*.test.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"],
      "drizzle": false
    },
    "apps/web": {
      "entry": ["e2e/**/*.ts"],
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts"],
      "ignoreDependencies": ["@tanstack/react-router-devtools"]
    },
    "packages/kit-i18n": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    }
  },
  "rules": {
    "exports": "warn",
    "types": "warn",
    "nsExports": "warn",
    "nsTypes": "warn"
  }
}
