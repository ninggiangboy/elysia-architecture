  },
  "dependencies": {
    "@kit/config": "workspace:*",
    "@kit/core": "workspace:*"
  },
  "peerDependencies": {
    "elysia": "^1.4.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@kit/http": "workspace:*",
    "@types/bun": "latest",
    "elysia": "^1.4.0",
    "zod": "^4.1.0"
  }
