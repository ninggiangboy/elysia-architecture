{
  "name": "@kit/storage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./http": {
      "bun": "./src/http.ts",
      "types": "./dist/http.d.ts",
